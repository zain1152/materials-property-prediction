# LEVEL 1 — DATA EXPLORATION AND CLEANING
# =====================================================================
def clean_sensor_data(file_path):
# Defines a function to handle the initial data loading, duplicate removal, and sensor glitch cleaning.
    print("--- Level 1: Loading & Cleaning Data ---", flush=True)
    # Prints a progress statement to the terminal screen and forces it to display immediately.
    if not os.path.exists(file_path):
    # Checks if the specified CSV file path is missing or typed incorrectly on your hard drive.
        print(f"⚠️ File not found at: {file_path}", flush=True)
        # Alerts you in the console that the data file could not be found at the path provided.
        sys.exit()
        # Halts the execution of the script immediately to prevent further errors.
    
    df = pd.read_csv(file_path)
    # Reads the CSV data file from your hard drive and loads it into a structure called a Pandas DataFrame.
    print(f"Successfully loaded file. Rows: {df.shape[0]}, Columns: {df.shape[1]}", flush=True)
    # Prints out the total number of rows and columns found inside your raw dataset.
    
    initial_shape = df.shape
    # Stores the original row and column dimensions in a variable before any cleaning takes place.
    df = df.drop_duplicates()
    # Scans the dataset and removes rows that are identical copies of other rows.
    print(f"Removed {initial_shape[0] - df.shape[0]} duplicate rows.", flush=True)
    # Calculates and displays exactly how many duplicate rows were discovered and eliminated.
    
    if 'day' in df.columns:
    # Checks if there is a column explicitly tracking the chronological timeline named 'day'.
        df = df.sort_values(['machine_id', 'day']).reset_index(drop=True)
        # Sorts the data by machine ID first, then sequentially by day, resetting the row numbers.
    
    print("Cleaning sensor anomalies...", flush=True)
    # Prints a message indicating that the script is checking for faulty hardware readings.
    for machine_id, group in df.groupby('machine_id'):
    # Isolates the data rows for one single machine at a time to analyze its individual history.
        rolling_mean = group['vibration_mm_s'].rolling(window=7, min_periods=1, center=True).mean()
        # Computes a moving average of vibration over a 7-day window centered on the current day.
        spike_mask = (group['vibration_mm_s'] > 8 * rolling_mean)
        # Creates a filter identifying days where the vibration reading is over 8 times higher than its moving average.
        df.loc[group.index[spike_mask], 'vibration_mm_s'] = np.nan
        # Replaces those extreme single-day electrical or telemetry sensor glitches with a blank 'NaN' value.
        
    sensor_cols = ['vibration_mm_s', 'temperature_C', 'pressure_psi']
    # Lists the specific numerical columns representing physical telemetry readings from the machinery.
    for col in sensor_cols:
    # Loops through each of the selected sensor columns one by one to handle missing entries.
        if col in df.columns:
        # Verifies that the specific sensor column exists in the dataset before modifying it.
            df[col] = df.groupby('machine_id')[col].ffill().groupby(df['machine_id']).bfill()
            # Fills missing values using forward-fill (carrying last reading ahead) followed by backward-fill.
        
    print("Data cleaning completed successfully.", flush=True)
    # Prints a confirmation that the data is clean, sorted, and free of invalid sensor anomalies.
    return df
    # Sends the cleaned DataFrame back to the main program loop.

# =====================================================================
# LEVEL 2 — FEATURE ENGINEERING FOR TIME-SERIES SENSOR DATA
# =====================================================================
def engineer_features(df):
# Defines a function to transform raw daily readings into trends that reveal machine wear and tear.
    print("\n--- Level 2: Engineering Features ---", flush=True)
    # Prints a header indicating that the feature engineering phase has started.
    features_df = df.copy()
    # Creates an independent copy of the cleaned data to prevent modifying the original dataframe.
    sensor_cols = ['vibration_mm_s', 'temperature_C', 'pressure_psi']
    # Selects the base engineering attributes to generate historical trend tracking values from.
    
    for col in sensor_cols:
    # Starts a loop to generate advanced statistical indicators for every separate physical sensor.
        features_df[f'{col}_roll_mean_7d'] = features_df.groupby('machine_id')[col].transform(lambda x: x.rolling(window=7, min_periods=1).mean())
        # Invents a new column calculating the 7-day rolling average to expose long-term degradation drift.
        features_df[f'{col}_roll_std_7d'] = features_df.groupby('machine_id')[col].transform(lambda x: x.rolling(window=7, min_periods=1).std().fillna(0))
        # Invents a column tracking 7-day volatility (standard deviation) to catch erratic parts loosening up.
        features_df[f'{col}_diff_1d'] = features_df.groupby('machine_id')[col].transform(lambda x: x.diff().fillna(0))
        # Invents a column capturing the 1-day change to catch sudden spikes or drops in reading acceleration.
        
    features_df['total_age_factor'] = features_df['install_age_years'] + (features_df['operating_hours'] / 8760.0)
    # Combines baseline age with a calculated fraction of years run to measure absolute asset wear lifespans.
    features_df = pd.get_dummies(features_df, columns=['machine_type'], drop_first=True)
    # Converts text categories like 'Pump' or 'Motor' into numeric binary 1s and 0s that ML models can process.
    print("Feature engineering complete.", flush=True)
    # Prints a confirmation that all mathematical trend features have been attached to the dataset.
    return features_df
    # Returns the enriched dataset back to the main execution workflow.

# =====================================================================
# LEVEL 3 & 4 — MODELING, SPLITTING & EVALUATION
# =====================================================================
def train_and_evaluate_pipeline(features_df):
# Defines a function to handle data splitting, train the models, and measure operational business metrics.
    print("\n--- Levels 3 & 4: Model Training & Evaluation ---", flush=True)
    # Prints a heading marking the start of the machine learning modeling phase.
    exclude_cols = ['machine_id', 'failure_event', 'failure_within_7_days', 'day', 'date', 'timestamp']
    # Lists columns that are identifiers, dates, or targets that must not be used as training features.
    feature_cols = [c for c in features_df.columns if c not in exclude_cols]
    # Uses list comprehension to isolate and keep only the purely predictive engineered columns.
    feature_cols = [c for c in feature_cols if pd.api.types.is_numeric_dtype(features_df[c])]
    # Automatically drops any remaining text columns to guarantee everything passed to math modules is a number.
    
    X = features_df[feature_cols]
    # Extracts the matrix of independent input variables (features) for model training.
    y = features_df['failure_within_7_days']
    # Extracts the dependent target column containing the binary answers (1 for imminent failure, 0 for healthy).
    groups = features_df['machine_id']
    # Identifies the machine grouping arrays used to control how data splits across validation folds.
    
    unique_machines = groups.unique()
    # Extracts a clean array of unique machine ID names present within the logs.
    train_machines = unique_machines[:30] if len(unique_machines) >= 30 else unique_machines[:int(len(unique_machines)*0.75)]
    # Reserves roughly 75% of your individual physical machines exclusively for training.
    test_machines = [m for m in unique_machines if m not in train_machines]
    # Collects the remaining 25% of unique physical machines to serve as a clean evaluation test set.
    
    X_train, y_train = X[groups.isin(train_machines)], y[groups.isin(train_machines)]
    # Slices input features and target labels for rows belonging only to the assigned training machines.
    X_test, y_test = X[groups.isin(test_machines)], y[groups.isin(test_machines)]
    # Slices input features and target labels for rows belonging only to the assigned evaluation machines.
    features_df_test = features_df[groups.isin(test_machines)].copy()
    # Creates an independent reference DataFrame copy of test machine rows to use for timeline calculations later.
    
    print("Training models...", flush=True)
    # Notifies the console that mathematical model fitting operations have started.
    lr_pipeline = Pipeline([
        ('scaler', StandardScaler()),
        ('lr', LogisticRegression(class_weight='balanced', random_state=42, max_iter=1000))
    ])
    # Bundles standard scale centering and an imbalance-weighted Logistic Regression baseline into a pipeline.
    lr_pipeline.fit(X_train, y_train)
    # Calculates scaling factors on training data and trains the internal baseline logistic equation.
    
    rf_model = RandomForestClassifier(n_estimators=100, class_weight='balanced', random_state=42, n_jobs=-1)
    # Initializes a Random Forest ensemble model with 100 decision trees adjusted for class imbalance.
    rf_model.fit(X_train, y_train)
    # Feeds the training data features and labels to build the ensemble tree networks.
    rf_probs = rf_model.predict_proba(X_test)[:, 1]
    # Generates the continuous decimal probability scores (from 0.0 to 1.0) indicating failure risk for test rows.
    
    precisions, recalls, thresholds = precision_recall_curve(y_test, rf_probs)
    # Sweeps through alternate threshold points to compute paired trade-off vectors for precision and recall.
    
    chosen_threshold = 0.30
    # Decides an operational risk limit of 30% to maximize machine warning signals over strict accuracy.
    custom_preds = (rf_probs >= chosen_threshold).astype(int)
    # Flags any row scoring a 0.30 probability or above as a predicted failure window (coding it as 1).
    
    print(f"\n=== RANDOM FOREST PERFORMANCE (Threshold = {chosen_threshold}) ===", flush=True)
    # Prints a header indicating performance metrics calculated at your custom threshold.
    print(classification_report(y_test, custom_preds), flush=True)
    # Computes and displays a comprehensive grid of precision, recall, and F1-scores for the evaluation.
    
    features_df_test['pred_risk'] = custom_preds
    # Appends the new binary custom prediction flags directly onto the test machine observation records.
    print("\n=== MAINTENANCE LEAD TIME METRICS ===", flush=True)
    # Prints a header indicating the start of industrial warning lead time tracking calculations.
    for m_id in test_machines:
    # Iterates step-by-step through each of the machines assigned to the validation test holdout set.
        m_data = features_df_test[features_df_test['machine_id'] == m_id].reset_index(drop=True)
        # Extracts chronologically ordered records isolated for that single specific test machine.
        if m_data['failure_event'].sum() > 0:
        # Checks if this specific machine actually encountered a catastrophic hardware failure event.
            fail_idx = m_data[m_data['failure_event'] == 1].index[0]
            # Pinpoints the exact index row number matching the day the asset completely broke down.
            flagged_days = m_data[(m_data['pred_risk'] == 1) & (m_data.index <= fail_idx)]
            # Filters for occurrences where your model flagged high risk on or prior to that breakdown day.
            if not flagged_days.empty:
            # Enters this block if the model raised at least one alarm ahead of the fatal crash day.
                print(f"Machine {m_id}: Lead time generated = {fail_idx - flagged_days.index[0]} days.", flush=True)
                # Calculates and logs the difference in days between the model's earliest warning flag and the actual crash.
                
    return lr_pipeline, rf_model, precisions, recalls, thresholds
    # Passes model components and precision-recall plotting curves back to the primary runtime routine.

