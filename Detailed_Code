def plot_portfolio_visuals(df, precisions, recalls, thresholds):
# Defines a function to output high-resolution chart images validating the engineering and model results.
    print("\n📈 Generating portfolio illustrations...", flush=True)
    # Logs to the screen that graphics generation tasks are running.
    import matplotlib.pyplot as plt
    # Imports the visualization module locally to construct figure elements.
    
    possible_time_cols = ['day', 'Day', 'DAY', 'date', 'Date', 'DATE', 'timestamp']
    # Defines a collection of alternate common column label configurations used to track timelines.
    time_col = next((c for c in possible_time_cols if c in df.columns), None)
    # Scans your database columns and extracts the string name matching whichever timeline indicator is present.
    
    if time_col is None:
    # Triggers an adjustment block if your column structures lack an explicit chronological tracker label.
        df = df.copy()
        # Generates a duplicate container to modify values without breaking source datasets.
        df['derived_day'] = df.groupby('machine_id').cumcount() + 1
        # Measures row locations within individual machine blocks to construct an incremental day tracker.
        time_col = 'derived_day'
        # Sets your newly calculated day column as the timeline axis baseline for plot operations.

    plt.figure(figsize=(12, 5))
    # Configures a wide display container window scaled to 12 inches across by 5 inches high.
    failed_machines = df[df['failure_event'] == 1]['machine_id'].unique()
    # Identifies identifiers of assets that logged an actual breakdown event inside the tracking period.
    healthy_machines = [m for m in df['machine_id'].unique() if m not in failed_machines]
    # Gathers identifiers of assets that cruised cleanly through the operation timeline without incident.
    
    if len(failed_machines) > 0 and len(healthy_machines) > 0:
    # Confirms examples exist for both classes before attempting to construct comparison plots.
        m_fail = failed_machines[0]
        # Extracts the identifier matching the very first machine that registered a catastrophic failure event.
        fail_data = df[df['machine_id'] == m_fail].sort_values(time_col)
        # Gathers and chronologically sorts history records tracking that specific failing component.
        plt.plot(fail_data[time_col], fail_data['vibration_mm_s'], label=f'Machine {m_fail} (Failed)', color='crimson', lw=2)
        # Plots a continuous crimson line tracing the rising vibration signals recorded across the asset's lifespan.
        
        fail_day = fail_data[fail_data['failure_event'] == 1][time_col].values[0]
        # Extracts the numerical timeline index marking the exact moment the selected asset crashed.
        plt.axvline(x=fail_day, color='black', linestyle='--', label='Actual Failure Event')
        # Draws a vertical black dashed line across the graph marking the exact day of structural destruction.
        
        m_healthy = healthy_machines[0]
        # Extracts the identifier matching the first machine that completed the observation run without damage.
        healthy_data = df[df['machine_id'] == m_healthy].sort_values(time_col)
        # Gathers and chronologically arranges log histories for that stable, non-failing asset.
        plt.plot(healthy_data[time_col], healthy_data['vibration_mm_s'], label=f'Machine {m_healthy} (Healthy)', color='teal', alpha=0.7)
        # Overlays a steady teal line demonstrating the normal baseline noise of an operational machine.
        
        plt.title("Sensor Degradation Over Time: Healthy vs. Failing Machine", fontsize=14, fontweight='bold')
        # Attaches an informative title header to your timeline visualization graph.
        plt.xlabel("Timeline", fontsize=12)
        # Assigns a label description to the horizontal axis of the coordinate framework.
        plt.ylabel("Vibration (mm/s)", fontsize=12)
        # Assigns a label description to the vertical scale tracking physical signal intensity.
        plt.legend()
        # Generates a color-coded legend boundary box indexing line representations on the figure display.
        plt.grid(True, alpha=0.3)
        # Attaches an underlying background alignment grid rendered at an unobtrusive opacity level.
        plt.tight_layout()
        # Adjusts border elements dynamically to prevent text descriptions from getting clipped.
        plt.savefig('sensor_degradation_chart.png', dpi=300)
        # Writes the finalized comparison plot out into a high-density standalone image file.
        print("💾 Saved image file: 'sensor_degradation_chart.png'", flush=True)
        # Logs file generation confirmation status directly out to the operational console.
        plt.close()
        # Flushes image parameters out of system RAM to ensure memory resources remain clean.

    plt.figure(figsize=(8, 5))
    # Prepares an alternate graphic plot framework structured to dimensions of 8 inches by 5 inches.
    plt.plot(thresholds, precisions[:-1], label='Precision', color='darkblue', lw=2)
    # Traces a dark blue curve demonstrating how prediction reliability improves as alert levels are raised.
    plt.plot(thresholds, recalls[:-1], label='Recall', color='darkorange', lw=2)
    # Traces an orange curve demonstrating how failure detection ranges drop off if alert levels are set too high.
    plt.axvline(x=0.30, color='red', linestyle=':', label='Chosen Threshold (0.30)')
    # Drops a red dotted marker flag tracking your customized cost-optimized decision threshold location.
    
    plt.title("Optimizing the Maintenance Alert Threshold", fontsize=14, fontweight='bold')
    # Attaches a bold header explaining the optimization metrics tracking system to viewers.
    plt.xlabel("Probability Threshold Decision Boundary", fontsize=12)
    # Attaches axis function descriptions to horizontal boundary layout grids.
    plt.ylabel("Score Metric", fontsize=12)
    # Attaches axis scale value explanations to vertical mapping arrays.
    plt.legend()
    # Instantiates variable mapping indicator blocks inside graphic chart borders.
    plt.grid(True, alpha=0.3)
    # Establishes structural backdrop navigation coordinate grids across figure workspaces.
    plt.tight_layout()
    # Organizes spacing margins automatically to stabilize look and layout balances.
    plt.savefig('model_threshold_optimization.png', dpi=300)
    # Saves your engineering optimization trade-off curves into an asset image report file.
    print("💾 Saved image file: 'model_threshold_optimization.png'", flush=True)
    # Confirms metric image extraction tracking operations completed safely in logs.
    plt.close()
    # Closes plotting figures cleanly to recycle standard system runtime resources.

