import os
import pandas as pd
from sqlalchemy import create_engine

# ==========================================
# 1. DYNAMIC DIRECTORY ANCHOR
# ==========================================
# This automatically forces Python to look inside 'D:\Automation_2'
script_dir = os.path.dirname(os.path.abspath(__file__))
os.chdir(script_dir)

print(f"🔄 Working directory successfully set to: {script_dir}")

# ==========================================
# 2. DATABASE CONNECTION (pgAdmin / PostgreSQL)
# ==========================================
DATABASE_TYPE = 'postgresql'
DBAPI = 'psycopg2'
HOST = 'localhost'
PORT = '5432'
USER = 'postgres'          
PASSWORD = '1234'  # <--- Change this to your actual pgAdmin password
DATABASE = 'ecommerce_portfolio'     

engine = create_engine(f"{DATABASE_TYPE}+{DBAPI}://{USER}:{PASSWORD}@{HOST}:{PORT}/{DATABASE}")

# ==========================================
# 3. CSV TO SQL TABLE MAPPING
# ==========================================
files_to_sync = {
    "categories.csv": "categories",
    "customers.csv": "customers",
    "order_items.csv": "order_items",
    "orders.csv": "orders",
    "products.csv": "products"
}

# ==========================================
# 4. EXECUTE SYNCHRONIZATION
# ==========================================
print("\n🚀 Starting Database Sync Process...\n" + "="*40)

for csv_file, table_name in files_to_sync.items():
    if os.path.exists(csv_file):
        print(f"📖 Found and reading local file: {csv_file}")
        df = pd.read_csv(csv_file)
        
        print(f"📥 Overwriting and updating pgAdmin table: '{table_name}'...")
        df.to_sql(table_name, con=engine, if_exists='replace', index=False)
        print(f"✅ Table '{table_name}' successfully updated!\n" + "-"*40)
    else:
        expected_path = os.path.join(script_dir, csv_file)
        print(f"⚠️ Skipping '{table_name}': File not found at {expected_path}\n" + "-"*40)

print("🎉 Success! All synchronization tasks have finished running.")